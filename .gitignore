.DS_Store
*.swp
.obsidian/

# secrets — never commit
deploy/.env
.claude/settings.local.json
deploy/claude-home/

# runtime state, not memory
.log/
__pycache__/

# Pushed-in integration data: other people's content, and large. The raw
# extract alone is 170KB of message bodies regenerated every 15 minutes, and
# putting that in history would make the repo a second copy of chat.db.
# The Reminders bridge: both sides are derived and rewritten every hour — the
# mirror from the obligation list, the extract by the Mac. Committing either
# would churn git hourly with a copy of what the sources already say.
integrations/reminders-mirror.json
integrations/reminders-apple.json
integrations/imessage.json
integrations/imessage-changed.json
integrations/contacts.json
integrations/calls.json

# The Gmail and Calendar extracts are the same class of thing, pulled here
# rather than pushed from the Mac. gmail.json is 270KB of subjects and
# addresses at a 150-thread cap and roughly twice that uncapped; calendar.json
# is small but rewritten every ten minutes by the dispatcher. Both are
# regenerable from the API in seconds, and neither is a decision.
#
# They were tracked for one afternoon by accident — `git add -A` swept them in
# — and removed with `git rm --cached`. The history that already exists is
# small enough to leave alone; the point is that it stops growing.
integrations/gmail.json
integrations/gmail-changed.json

# integrations/gmail-escaped.json is deliberately NOT here. It records
# threads that left the 14-day window before anyone judged them, and it is
# the one mail file that cannot be regenerated: once a thread is outside the
# window the extractor will never mention it again. Losing it means losing
# the only evidence those threads existed.
integrations/calendar.json

# Nor the email triage state, for the same reason: conclusions, not data.
# integrations/email-state.json is deliberately absent from this list.

# But NOT the triage state. That file is not pushed-in data, it is decisions:
# every conclusion the agent reached and every task Alex closed by hand. It is
# 28KB, it cannot be regenerated from the Mac, and leaving it untracked meant
# the one part of the system with no undo button was the part that records what
# he decided. Everything else here — journal, people, todo — is already tracked;
# this is the same class of thing.

# Notification credentials: an SMS provider bearer token and a push topic.
# Host-only on purpose — see the header of the file itself. Never in git.
deploy/notify.env

# Gmail MCP credentials: a Google refresh token, one directory per mailbox.
# Never in git.
deploy/gmail-state/
deploy/gmail-state-*/
deploy/calendar-state/
deploy/drive-state/

# Account-keyed grants (2026-09-02). One directory per Google account, one
# token inside it carrying every scope that account was granted. Supersedes
# the four capability-keyed directories above, which stay readable until
# each account is re-granted.
deploy/google/

# Cached message text for the web UI. Derived (regenerable from Gmail while
# the thread exists), personal, and large. The conclusions in
# integrations/email-state.json are the record; this is a convenience so a
# task can show its mail instead of sending him to Gmail.
.log/mail-cache/

# Swift build products for the Mac app — regenerated by build.sh.
deploy/mac-app/.build/
deploy/mac-server/.build/

# APNs auth key (.p8) — a signing secret for pushes to his phone; host-only, like notify.env
deploy/apns/
# The iPhone/iPad/Mac app: the .xcodeproj is generated from
# deploy/ios-app/project.yml by xcodegen, and build/ is derived data.
deploy/ios-app/Obligations.xcodeproj/
deploy/ios-app/build/
# where he is, from the app: derived, personal, rewritten all day
integrations/location.json

# The accumulated sender-name map: derived from mail metadata, rebuilt by the extractor
integrations/sender-names.json

# The agent service's two pinned packages, installed in place on the Mac
# (the container installs them at /node_modules). package-lock.json is tracked.
deploy/agent-service/node_modules/

# The server's GitHub deploy key (obligations only) and GitHub's host keys.
# Read by git under the sandbox, which denies ~/.ssh. Never committed.
deploy/github/
