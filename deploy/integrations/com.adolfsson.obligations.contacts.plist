<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Syncs the handle → name table. Every 6 hours, not every 15 minutes: an address
  book changes a few times a month, and the cost of being six hours stale is that
  one brand-new contact shows as a phone number until the next run.

  Runs __PYTHON__ (resolved at install time) directly, for the same TCC reason as
  the other agents — macOS attributes Full Disk Access to the process it launches,
  so a shell wrapper would need its own grant.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.obligations.contacts</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__HOME__/obligations/deploy/integrations/contacts-extract.py</string>
    <string>--push</string>
    <string>linuxbox:obligations/integrations/contacts.json</string>
  </array>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/obligations-contacts.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/obligations-contacts.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict>
</plist>
