# cp to deploy/.env — .env is gitignored and must STAY that way.
# This container reads the owner's email and holds their personal memory. Treat every
# value here as a credential worth stealing.

# --- Owner ----------------------------------------------------------------
# Who the assistant works for. Prompts and drafted sign-offs use it.
OWNER_NAME=Alex Rivera
# OWNER_FIRST=Alex

# --- Auth ---------------------------------------------------------------
# Preferred: subscription login. Run ./deploy/login.sh once — the credentials
# persist in deploy/claude-home/ (a gitignored volume mounted into every job
# container) and jobs run against your plan, not metered API billing.
#
# Alternative: an API key, if you'd rather not have login credentials sitting
# on the server, or the box is shared and you want billing separated.
# ANTHROPIC_API_KEY=sk-ant-...

# THE model setting for the whole system. Read by the scheduled jobs
# (deploy/entrypoint.sh), the chat session (deploy/chat-entry.sh), and the agent
# service (deploy/agent-service/server.mjs), all of which get this file via
# --env-file. Leave it unset and they each default to claude-opus-5.
# The chat UI's picker overrides it per turn; this is what everything falls back
# to, and what the unattended jobs use.
# OBLIGATIONS_MODEL=claude-opus-5

# --- Web access ---------------------------------------------------------
# The web frontend is published by a Cloudflare tunnel and gated by Cloudflare
# Access (Google sign-in). Both services bind loopback, so the tunnel is the
# only way in and every request is authenticated before it arrives.
#
# From Zero Trust > Settings > Custom Pages / your team domain, and from the
# Access application's overview page:
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_AUD=<the application's AUD tag>
#
# 1 = verify the Access JWT on every request and refuse anything unsigned.
# Leave it unset only while setting the tunnel up; the service refuses to start
# if this is 1 and the two values above are missing, so a typo can't silently
# downgrade an authenticated deployment into an open one.
# REQUIRE_ACCESS=1

#
# Escape hatch. Unset (or 'loopback') = tunnel only. 'tailnet' rebinds the
# service to the tailscale interface so you can reach it at 100.64.0.1:7683
# when Cloudflare is the thing that's broken. That path has NO sign-in in front
# of it — put it back when you're done.
# OBLIGATIONS_BIND=tailnet

# The tunnel's own connector token does NOT go here. It lives in
# /etc/cloudflared/obligations.env, root-only, because this file is --env-file'd into
# the agent containers that read untrusted email.

# Notification channel — how nagging actually reaches a phone.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# VNC password for the interactive desktop container
# VNC_PASSWORD=

# --- Gmail realtime push (Email 0, phase 4) -------------------------------
#
# All four must be set for the endpoint to exist. Missing any and
# POST /hooks/gmail/<secret> answers 503 rather than serving half-configured —
# a misconfiguration and an open endpoint must never look alike.
#
# This route is the ONE thing exempt from Cloudflare Access, because Google
# cannot sign in. Its authentication is the OIDC token Pub/Sub attaches,
# verified in deploy/agent-service/hook/oidc.mjs against Google's keys, the
# audience below, and the service account below. The path secret is not the
# authentication: it is there so a scanner sweeping the hostname never reaches
# the JWKS fetch, and so a leaked URL alone is not enough.

# A long random path segment. `openssl rand -hex 24`.
# GMAIL_PUSH_SECRET=

# The audience configured on the push subscription. Must match EXACTLY, and it
# is the check that stops a token Google minted for any other service being
# replayed here. Use the full endpoint URL.
# GMAIL_PUSH_AUDIENCE=https://hook.example.com/hooks/gmail

# The service account the subscription pushes as, from its OIDC settings.
# GMAIL_PUSH_SA=gmail-push@obligations-rivera.iam.gserviceaccount.com

# The Pub/Sub topic Gmail publishes to. Setting this also arms users.watch on
# startup and daily — the watch lasts 7 days and lapses SILENTLY, so re-arming
# daily turns that into six days of slack.
# gmail-api-push@system.gserviceaccount.com needs Pub/Sub Publisher ON THIS
# TOPIC. That grant is the step everyone forgets and users.watch fails with an
# error that does not name it.
# GMAIL_PUSH_TOPIC=projects/obligations-rivera/topics/gmail-push

# Optional. 'strict' makes the ratified sender table in rules/email-triage.md a
# hard gate instead of a fast lane. Default is open — Alex's call, 2026-08-30:
# a missed code is the failure he cares about, and he mutes SMS overnight.
# REALTIME_MODE=strict
