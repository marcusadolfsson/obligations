# Long-lived interactive container: Xvfb + VNC + noVNC + a browser.
# Separate image on purpose — the job image stays ~200MB and disposable.
# Same obligations volume, so OAuth tokens and files land where the jobs will find them.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11vnc fluxbox novnc websockify \
      chromium fonts-liberation \
      git ca-certificates ripgrep tini xterm x11-utils \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

RUN useradd -m -u 1001 agent
USER agent
WORKDIR /obligations

ENV OBLIGATIONS=/obligations \
    DISPLAY=:1 \
    SCREEN=1440x900x24 \
    CHROME_BIN=/usr/bin/chromium

COPY --chown=agent:agent desktop-start.sh /usr/local/bin/desktop-start.sh

EXPOSE 5900 6080
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/desktop-start.sh"]
